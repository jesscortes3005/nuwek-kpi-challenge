# Copia este archivo a .env  (cp .env.example .env)  y ajusta los valores.
# NUNCA subas el archivo .env a GitHub.

# Base de datos. SQLite por defecto (no requiere instalar nada).
# Para PostgreSQL sería, por ejemplo: postgresql+psycopg2://usuario:password@localhost:5432/ventas
DATABASE_URL=sqlite:///./ventas.db

# Ejemplo de secreto para un servicio externo futuro. Hoy NO se usa.
API_KEY=cambia_esto
